{
  "commands": {
    "failed-syncs": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/failed-syncs.sql",
        "500",
        "--sync_status",
        "{sync_status}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "sync_status": {
          "pattern": "FAIL|OTHER|FRAGMENTED",
          "default": "FAIL"
        }
      },
      "timeoutMs": 90000
    },
    "projects": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/projects.sql",
        "100",
        "--q",
        "{q}",
        "--status",
        "{status}",
        "--sort",
        "{sort}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "status": {
          "pattern": "all|ACTIVE|PAUSED",
          "default": "all"
        },
        "sort": {
          "pattern": "active|name|recent",
          "default": "active"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "project-connections": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/project-connections.sql",
        "100",
        "--project_id",
        "{project}",
        "--q",
        "{q}",
        "--sort",
        "{sort}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "project": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "sort": {
          "pattern": "status|service|name",
          "default": "status"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "connections": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/connections.sql",
        "100",
        "--q",
        "{q}",
        "--platform",
        "{platform}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "platform": {
          "pattern": "all|ADJUST|AIRBRIDGE|APPLE|APPSFLYER_AGG|APPSFLYER_COHORT|APPSFLYER_RAW|CAFE24|GOOGLE_ADS|GOOGLE_ANALYTICS|GOOGLE_SHEET|KAKAO_KEYWORD|KAKAO_MOMENT|META|NAVER_SA|TIKTOK|FILE",
          "default": "all"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "connection-group": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/connection-group.sql",
        "100",
        "--ids",
        "{ids}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "ids": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,99}"
        }
      },
      "timeoutMs": 90000
    },
    "groups-list": {
      "exec": "node",
      "args": [
        "groups.mjs",
        "{env}",
        "list"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        }
      },
      "timeoutMs": 15000
    },
    "groups-edit": {
      "exec": "node",
      "args": [
        "groups.mjs",
        "{env}",
        "edit",
        "{body}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "body": {
          "pattern": "(?:[0-9a-f]{2}){1,32000}"
        }
      },
      "timeoutMs": 15000
    },
    "fitting-rooms": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/fitting-rooms.sql",
        "100",
        "--q",
        "{q}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "fitting-room-connections": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/fitting-room-connections.sql",
        "100",
        "--fitting_room_id",
        "{room}",
        "--q",
        "{q}",
        "--sort",
        "{sort}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "room": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "sort": {
          "pattern": "status|service|name",
          "default": "status"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "fitting-room-flow": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/fitting-room-flow.sql",
        "500",
        "--fitting_room_id",
        "{room}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "room": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        }
      },
      "timeoutMs": 90000
    },
    "delete-syncs": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/delete-syncs.sql",
        "100",
        "--ids",
        "{ids}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "ids": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,99}"
        }
      },
      "timeoutMs": 330000
    },
    "delete-other-syncs": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/delete-other-syncs.sql",
        "100",
        "--ids",
        "{ids}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "ids": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,99}"
        }
      },
      "timeoutMs": 330000
    },
    "mark-syncs-fail": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/mark-syncs-fail.sql",
        "100",
        "--ids",
        "{ids}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "ids": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,99}"
        }
      },
      "timeoutMs": 330000
    },
    "project-members": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/project-members.sql",
        "200",
        "--project_id",
        "{project}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "project": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        }
      },
      "timeoutMs": 90000
    },
    "user-search": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/user-search.sql",
        "200",
        "--project_id",
        "{project}",
        "--q",
        "{q}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "project": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){2,200}"
        }
      },
      "timeoutMs": 90000
    },
    "add-project-user": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/add-project-user.sql",
        "200",
        "--user_id",
        "{user}",
        "--project_id",
        "{project}",
        "--role",
        "{role}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "user": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "project": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "role": {
          "pattern": "admin|editor|viewer",
          "default": "viewer"
        }
      },
      "timeoutMs": 330000
    },
    "create-project": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/create-project.sql",
        "1",
        "--name",
        "{name}",
        "--user_id",
        "{user}",
        "--project_status",
        "{status}",
        "--plan",
        "{plan}",
        "--end_date",
        "{end}",
        "--members",
        "{members}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "name": {
          "pattern": "(?:[0-9a-f]{2}){1,200}"
        },
        "user": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "status": {
          "pattern": "ACTIVE|PAUSED|NEED_PAYMENT",
          "default": "PAUSED"
        },
        "plan": {
          "pattern": "BASIC|DEMO|ENTERPRISE",
          "default": "BASIC"
        },
        "end": {
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "members": {
          "pattern": "(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:(?:admin|editor|viewer)(?:,[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:(?:admin|editor|viewer)){0,49})?",
          "default": ""
        }
      },
      "timeoutMs": 330000
    },
    "project-schedules": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/project-schedules.sql",
        "500",
        "--projects",
        "{projects}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "projects": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,49}"
        }
      },
      "timeoutMs": 90000
    },
    "update-schedules": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/update-schedules.sql",
        "5000",
        "--projects",
        "{projects}",
        "--daily_cron",
        "{hour}",
        "--range",
        "{range}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "projects": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,49}"
        },
        "hour": {
          "pattern": "[4-9]|1[0-9]|2[0-3]"
        },
        "range": {
          "pattern": "DAY|LAST_2DAYS|WEEK|MONTH|THIS_MONTH|THIS_2MONTH"
        }
      },
      "timeoutMs": 330000
    }
  }
}
