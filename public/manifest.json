{
  "manifest_version": 3,
  "name": "Refit Sidecar",
  "version": "0.0.0",
  "description": "Drawer for app.refit.ai that runs allowlisted local commands (failed sync_requests) through a native host.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Refit Sidecar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://app.refit.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
