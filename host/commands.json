{
  "commands": {
    "failed-syncs": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/failed-syncs.sql",
        "500"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        }
      },
      "timeoutMs": 90000
    },
    "projects": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/projects.sql",
        "100",
        "--q",
        "{q}",
        "--status",
        "{status}",
        "--sort",
        "{sort}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "status": {
          "pattern": "all|ACTIVE|PAUSED",
          "default": "all"
        },
        "sort": {
          "pattern": "active|name|recent",
          "default": "active"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "project-connections": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/project-connections.sql",
        "100",
        "--project_id",
        "{project}",
        "--q",
        "{q}",
        "--sort",
        "{sort}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "project": {
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "sort": {
          "pattern": "status|service|name",
          "default": "status"
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "connections": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/connections.sql",
        "100",
        "--q",
        "{q}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "fitting-rooms": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/fitting-rooms.sql",
        "100",
        "--q",
        "{q}",
        "--offset",
        "{offset}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "q": {
          "pattern": "(?:[0-9a-f]{2}){0,200}",
          "default": ""
        },
        "offset": {
          "pattern": "[0-9]{1,5}",
          "default": "0"
        }
      },
      "timeoutMs": 90000
    },
    "delete-syncs": {
      "exec": "node",
      "args": [
        "tabularis-query.mjs",
        "/Applications/tabularis.app/Contents/MacOS/tabularis",
        "{env}",
        "sql/delete-syncs.sql",
        "100",
        "--ids",
        "{ids}"
      ],
      "params": {
        "env": {
          "pattern": "prod|stag",
          "default": "prod"
        },
        "ids": {
          "pattern": "[0-9a-fA-F-]{36}(?:,[0-9a-fA-F-]{36}){0,99}"
        }
      },
      "timeoutMs": 330000
    }
  }
}
